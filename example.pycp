/*
=============================================================
Pycp 示例：类定义 + io / Pycp 内置库
=============================================================
*/

import io
import Pycp

/*
---- 类定义 ----
成员变量声明（仅声明，初始化在 __initialize__ 中完成）。
__initialize__ 为构造函数，创建实例时自动调用。
__string__ 为字符串转换方法（Pycp.String / io.stdout.write 转换时自动调用）。
*/

class Point{
	x = None
	y = None

	func __initialize__(self, x, y){
		self.x = x
		self.y = y
	}

	func __string__(self){
		return "Point(" + Pycp.String(self.x) + ", " + Pycp.String(self.y) + ")"
	}

	# 运算符重载：__addition__ 实现 + 操作
	func __addition__(self, other){
		return Point(self.x + other.x, self.y + other.y)
	}
}

# ---- 创建实例 ----
p = Point(1, 2)
io.stdout.write(Pycp.String(p))
io.stdout.write("\n")

# ---- 运算符重载：+ 转发到 __addition__ ----
q = Point(3, 4)
r = p + q
io.stdout.write(Pycp.String(r))
io.stdout.write("\n")

# ---- stdin 读取 ----
io.stdout.write("请输入内容：")
line = io.stdin.readline()
io.stdout.write("你输入了：" + line)
io.stdout.write("\n")
