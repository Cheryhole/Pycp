// 相等性语义回归：EQ/NE 统一 Boolean + Python 默认的身份语义。
import io
import pycp

class Box {
	v = 1
	// 用户自定义相等：按字段比较
	func __equal__(self, other) {
		return self.v == other.v
	}
}

class Plain {
	v = 1
}

class OnlyNe {
	v = 1
	func __not_equal__(self, other) {
		return self.v != other.v
	}
}

func main() {
	// 1) EQ / NE 结果统一为 Boolean（旧：!= 返回 1/0）
	io.print("int-eq=" + pycp.String(1 == 1))
	io.print("int-ne=" + pycp.String(1 != 2))
	io.print("int-ne-same=" + pycp.String(1 != 1))
	io.print("float-ne=" + pycp.String(pycp.Float("1.5") != pycp.Float("2.5")))

	// 2) None 与自身相等（旧：Non-comparable 短路为 0）
	io.print("none-eq-none=" + pycp.String(None == None))
	io.print("none-ne-int=" + pycp.String(None != 1))

	// 3) 跨类型比较仍为 Boolean
	io.print("str-eq-int=" + pycp.String("a" == 1))

	// 4) 实例：类定义 __equal__ 时按用户语义
	a = Box()
	b = Box()
	io.print("user-eq-1=" + pycp.String(a == b))
	b.v = 2
	io.print("user-eq-2=" + pycp.String(a == b))
	// 未定义 __not_equal__：取 __equal__ 的否定
	io.print("user-ne=" + pycp.String(a != b))

	// 5) 实例：未定义相等方法 -> Python 默认身份语义（不再抛 TypeError）
	p = Plain()
	q = Plain()
	io.print("plain-eq-other=" + pycp.String(p == q))
	io.print("plain-eq-self=" + pycp.String(p == p))
	io.print("plain-ne-other=" + pycp.String(p != q))

	// 6) 只定义 __not_equal__ 时走它；== 回退身份语义
	n1 = OnlyNe()
	n2 = OnlyNe()
	io.print("onlyne-ne-same=" + pycp.String(n1 != n2))
	n2.v = 9
	io.print("onlyne-ne-diff=" + pycp.String(n1 != n2))
	io.print("onlyne-eq-fallback=" + pycp.String(n1 == n2))
}
main()
