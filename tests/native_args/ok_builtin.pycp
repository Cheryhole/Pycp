import io
import pycp

io.print(pycp.String(123))
io.print(pycp.Integer("42"))
io.print(pycp.Boolean(1))
io.print(pycp.List([1, 2]))

io.print(pycp.FixedList())
io.print(pycp.FixedList([1, 2]))
io.print(pycp.Map())
io.print(pycp.Map([["a", 1]]))

io.print(pycp.String() == "")
io.print(pycp.Integer() == 0)
io.print(pycp.Boolean() == False)
io.print(pycp.Boolean() == True)
io.print(pycp.List())
io.print(pycp.List().length())

b = [1, 2]
io.print("typeof-list=" + pycp.String(pycp.typeof(b)()))
io.print("typeof-string-empty=" + pycp.String(pycp.typeof("s")() == ""))
io.print("typeof-map=" + pycp.String(pycp.typeof(pycp.Map())()))

io.print(pycp.insp([1, 2]))
io.print(pycp.typeof(1))

l = [1, 2]
io.print(l.length())
l.append(3)
io.print(l)

fl = pycp.FixedList([7, 8])
io.print(fl.length())

m = pycp.Map()
m["k"] = 1
io.print(m.length())
io.print(m.keys())

o = pycp.Object()
io.print(o.__string__())

io.print("NATIVE OK")
