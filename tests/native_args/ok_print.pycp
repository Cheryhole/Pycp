import io

class Duck {
	func write(self, s) {
		io.stdout.write("duck:" + s)
		return None
	}
	func flush(self) {
		io.stdout.write("duck:flush\n")
		return None
	}
}

func main() {

	io.print(1, "a", [1, 2])

	io.print(1, 2, 3, sep = "-")
	io.print(1, 2, sep = None)

	io.print("A", end = "")
	io.print("B", end = "C\n")
	io.print("D", end = None)

	io.print()

	io.print("to stderr", file = io.stderr)

	io.print("flushed", flush = 1)

	io.print("hello", file = Duck(), flush = True)
	io.print("PRINT OK")
}
main()
