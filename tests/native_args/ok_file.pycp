import io

f = io.File("data.txt", "w")
f.write("hello\n")
f.close()

g = io.File("data.txt")
io.print(g.read())
g.close()

h = io.File("data.txt")
io.print(h.read(2))
h.close()

r1 = io.File("data.txt")
io.print(r1.readline())
r1.close()

r2 = io.File("data.txt")
io.print(r2.readlines())
r2.close()

k = io.File("data.txt")
k.open("data.txt")
io.print(k.read())
k.close()

k2 = io.File("data.txt")
k2.open("data.txt", "r")
io.print(k2.read())
k2.close()
io.print(k2.closed)

io.print("FILE OK")
