import io
import classtools

// 模块级装饰器测试：@decorator_expr func name(...) {...}

// 恒等装饰器：直接返回原函数（不依赖闭包捕获）
func identity(f) {
	return f
}

@identity
func greet() {
	return "hello"
}

io.print(greet())      // hello

// 类内成员装饰器（classtools 私有成员）
class Counter {
	@classtools.private
	x = 0

	func inc(self) {
		self.x = self.x + 1
		return self.x
	}
}

c = Counter()
io.print(c.inc())      // 1
io.print(c.inc())      // 2

io.print("done")
