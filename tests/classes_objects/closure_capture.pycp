import io

func wrap(f) {
	func g() {
		return f()
	}
	return g
}

@wrap
func decorated() {
	return 8
}

func base2() {
	return 9
}

base2 = wrap(base2)

func outer() {
	x = 100

	func mid() {
		func inner() {
			return x
		}
		return inner
	}

	return mid()
}

func make_adder(k) {
	func add(v) {
		return v + k
	}
	return add
}

func main() {
	fail = 0

	if (decorated() == 8) {
	} else {
		io.print("closure_capture: decorated closure mismatch")
		fail = fail + 1
	}

	if (base2() == 9) {
	} else {
		io.print("closure_capture: manual closure mismatch")
		fail = fail + 1
	}

	o = outer()
	if (o() == 100) {
	} else {
		io.print("closure_capture: transitive capture mismatch")
		fail = fail + 1
	}

	a = make_adder(3)
	if (a(4) == 7) {
	} else {
		io.print("closure_capture: adder mismatch")
		fail = fail + 1
	}

	n = 0
	repeat 200 {
		repeat 50 {
			tmp = make_adder(1)
			n = n + 1
		}
	}
	if (n == 10000) {
	} else {
		io.print("closure_capture: nested repeat counter broken")
		fail = fail + 1
	}

	if (a(10) == 13) {
	} else {
		io.print("closure_capture: closure invalidated")
		fail = fail + 1
	}

	if (fail == 0) {
		io.print("TEST PASS: closure_capture")
	}
}

main()
