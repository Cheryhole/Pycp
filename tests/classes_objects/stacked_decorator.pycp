import io
import pycp
import classtools
from classtools import readonly

func identity(f) {
	return f
}

func d1(f) {
	func g() {
		return 1
	}
	return g
}

func d2(f) {
	func g() {
		return 2
	}
	return g
}

func d3(f) {
	func g() {
		return 3
	}
	return g
}

func scale1(v) {
	return v * 10 + 1
}

func scale2(v) {
	return v * 10 + 2
}

@d1
@d2
@d3
func layered() {
	return 0
}

@d2 func single() {
	return 0
}

@scale1
@scale2
STACKED_NUM = 5

@readonly
@identity
STACKED_CONST = 9

@identity
@readonly
class Point {

	@classtools.private
	@readonly
	x = 7

	@classtools.private
	y = 8

	@identity
	@identity
	func sum(self) {
		return self.x + self.y
	}
}

func main() {
	fail = 0

	if (layered() == 1) {
	} else {
		io.print("stacked_decorator: function order mismatch")
		fail = fail + 1
	}

	if (single() == 2) {
	} else {
		io.print("stacked_decorator: single decorator function broken")
		fail = fail + 1
	}

	if (STACKED_NUM == 521) {
	} else {
		io.print("stacked_decorator: variable stacking mismatch")
		fail = fail + 1
	}

	if (STACKED_CONST == 9) {
	} else {
		io.print("stacked_decorator: readonly stacked variable mismatch")
		fail = fail + 1
	}

	p = Point()
	if (p.sum() == 15) {
	} else {
		io.print("stacked_decorator: class/member/method stacking mismatch")
		fail = fail + 1
	}

	io.print(pycp.insp(p))

	if (fail == 0) {
		io.print("TEST PASS: stacked_decorator")
	}
}

main()
