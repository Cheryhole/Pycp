// Boolean 类型基础行为验证。
// 约束：断言用整数比较（String 比较受限），输出用 io.print 展示。
import io
import pycp

func main() {
	// 1) 关键字打印：io.print(True) -> "True"，io.print(False) -> "False"
	io.print(True)
	io.print(False)

	// 2) 条件判断：if (True) 进入，if (False) 不进入
	if (True) {
		io.print("cond_true_ok")
	}
	if (False) {
		io.print("cond_false_should_not_appear")
	}

	// 3) 真假判定：IsFalse 行为
	//    if (False) 等价于 if (IsFalse)，False 为伪 -> 不进入（已测第 1 部分）
	//    True 为真 -> 进入（已测第 1 部分 if(True)）

	// 4) 值与 Integer 互通：True 值 1，False 值 0
	if (True != 1) {
		io.print("True!=1 mismatch")
		return None
	}
	if (False != 0) {
		io.print("False!=0 mismatch")
		return None
	}

	// 5) 比较互通：True == 1，False == 0 为真
	if (True == 1) {
		io.print("true_eq_1_ok")
	}
	if (False == 0) {
		io.print("false_eq_0_ok")
	}
	// 注意：True == False 应为假（值 1 != 0）
	if (True == False) {
		io.print("true_eq_false_unexpected")
		return None
	}

	// 6) 算术继承 Integer：True + 1 = 2（返回 Integer）
	if (True + 1 != 2) {
		io.print("True+1 mismatch")
		return None
	}

	// 7) Pycp 模块：pycp.Boolean 根据真值返回 True/False
	if (pycp.Boolean(1) != True) {
		io.print("pycp.Boolean(1) mismatch")
		return None
	}
	if (pycp.Boolean(0) != False) {
		io.print("pycp.Boolean(0) mismatch")
		return None
	}
	// pycp.Boolean(0) 应为 False 值，pycp.Boolean(1) 应为 True 值
	b0 = pycp.Boolean(0)
	b1 = pycp.Boolean(1)
	if (b0 != False) {
		io.print("pycp.Boolean(0) mismatch")
		return None
	}
	if (b1 != True) {
		io.print("pycp.Boolean(1) mismatch")
		return None
	}

	// 8) 类型名
	io.print(pycp.Boolean(1).__name__)

	io.print("IMPORT TEST PASS: boolean_basic")
}

main()
