import io
import pycp

func main() {

	io.print(True)
	io.print(False)

	if (True) {
		io.print("cond_true_ok")
	}
	if (False) {
		io.print("cond_false_should_not_appear")
	}

	if (True != 1) {
		io.print("True!=1 mismatch")
		return None
	}
	if (False != 0) {
		io.print("False!=0 mismatch")
		return None
	}

	if (True == 1) {
		io.print("true_eq_1_ok")
	}
	if (False == 0) {
		io.print("false_eq_0_ok")
	}

	if (True == False) {
		io.print("true_eq_false_unexpected")
		return None
	}

	if (True + 1 != 2) {
		io.print("True+1 mismatch")
		return None
	}

	if (pycp.Boolean(1) != True) {
		io.print("pycp.Boolean(1) mismatch")
		return None
	}
	if (pycp.Boolean(0) != False) {
		io.print("pycp.Boolean(0) mismatch")
		return None
	}

	b0 = pycp.Boolean(0)
	b1 = pycp.Boolean(1)
	if (b0 != False) {
		io.print("pycp.Boolean(0) mismatch")
		return None
	}
	if (b1 != True) {
		io.print("pycp.Boolean(1) mismatch")
		return None
	}

	io.print(pycp.Boolean(1).__name__)

	io.print("IMPORT TEST PASS: boolean_basic")
}

main()
