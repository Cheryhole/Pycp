import io

/* 多行注释：这是
   跨越多行的块注释
*/

a = 1
b = 2 /* 行内块注释 */ + 3

c = a + b

/* 块注释出现在语句之间 */
if c > 0 {
    io.print("positive")
} elif c == 0 /* 注释在 elif 行 */ {
    io.print("zero")
} else {
    io.print("negative")
}

s = "hello // not comment /* still not */ end"

io.print(a)
io.print(b)
io.print(c)
io.print(s)
