import io
import pycp

func f(a, b = 10) {
	return a + b
}

func g(x, y = f(1, 2)) {
	io.print("g y=" + pycp.String(y))
}
func main() {
	if (f(1) != 11) {
		io.print("f(1) default fail")
		return None
	}
	if (f(1, 2) != 3) {
		io.print("f(1,2) fail")
		return None
	}

	an = func(z, w = 100) {
		return z + w
	}
	if (an(1) != 101) {
		io.print("anon default fail")
		return None
	}
	g(0)
	io.print("DEFAULT ARGS PASS")
}
main()
