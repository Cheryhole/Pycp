// 顶层/匿名函数默认值（本特性第一阶段稳定形态）
import io
import pycp

func f(a, b = 10) {
	return a + b
}
// 任意表达式默认值：定义期求值一次（f(1, 2) == 3）
func g(x, y = f(1, 2)) {
	io.print("g y=" + pycp.String(y))
}
func main() {
	if (f(1) != 11) {
		io.print("f(1) default fail")
		return None
	}
	if (f(1, 2) != 3) {
		io.print("f(1,2) fail")
		return None
	}
	// 匿名函数同样适用
	an = func(z, w = 100) {
		return z + w
	}
	if (an(1) != 101) {
		io.print("anon default fail")
		return None
	}
	g(0)
	io.print("DEFAULT ARGS PASS")
}
main()
