// 场景：多层依赖导入图（A 本文件 -> B、C 各自独立被导入）。
// 验证入口 import 多个模块后，均可经 mod.xxx 访问并组合调用。
import io
import Pycp
import mod_nested_b as nested_b
import mod_nested_c as nested_c

func main() {
	// 跨模块组合：C 的面积函数（pi 由入口传入，经 mod 顶层常量获取）
	area = nested_c.nested_c_area(2, nested_c.nested_c_pi)   // 3 * 2 * 2 = 12
	combined = nested_b.nested_b_combine(area)
	if (combined != 24) {
		io.print("nested_deps: combine mismatch got " + Pycp.String(combined))
		return None
	}
	if (nested_c.nested_c_pi + 1 != 4) {
		io.print("nested_deps: pi+1 mismatch")
		return None
	}
	io.print("IMPORT TEST PASS: nested_deps")
}

main()
