// 场景：from 原生模块 import 成员（from io import stdout / from pycp import String）。
import io
import pycp
from io import stdout
from pycp import String

func main() {
	// from io import stdout：应可直接使用（写出文本，不比较返回值）
	stdout.write(pycp.String("from_native: from io import stdout\n"))

	// from pycp import String：构造并输出验证（避免 String 比较受限）
	str99 = String(99)
	io.print(str99)

	// 同文件中普通 import 仍可访问其余成员
	io.print("from_native: io.print still reachable")

	io.print("IMPORT TEST PASS: from_native")
}

main()
