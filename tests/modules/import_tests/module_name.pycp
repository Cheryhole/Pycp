import io
import pycp
import mod_name
import mod_name_over

func main() {
	if (__name__ == "__main__") {
	} else {
		io.print("module_name: entry __name__ != __main__")
		return None
	}
	if (pycp.__name__ == "__main__") {
	} else {
		io.print("module_name: pycp.__name__ != __main__")
		return None
	}
	if (mod_name.__name__ == "mod_name") {
	} else {
		io.print("module_name: mod_name.__name__ != 模块名")
		return None
	}
	if (mod_name.inside == "mod_name") {
	} else {
		io.print("module_name: mod_name 内部裸 __name__ 未注入")
		return None
	}
	if (mod_name_over.__name__ == "override_me") {
	} else {
		io.print("module_name: 显式 __name__ 覆盖未生效")
		return None
	}
	if (mod_name_over.inside == "override_me") {
	} else {
		io.print("module_name: 显式 __name__ 内部引用未生效")
		return None
	}
	io.print("IMPORT TEST PASS: module_name")
}
main()
