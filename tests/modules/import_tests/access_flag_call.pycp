// 访问控制装饰器「直接调用」形式的跨模块效果断言：
//   private(secret) / private(hidden) → 跨模块不可见（见 private_import_denied）
//   public(shown) / public(visible)   → 可 import / 调用
//   readonly(CONST)                   → 可读
import io
import pycp
from mod_flag import shown, visible, CONST
import mod_flag

func main() {
	if (shown == 2) {
	} else {
		io.print("access_flag_call: public(shown) 后变量导入失败")
		return None
	}
	if (visible() == 5) {
	} else {
		io.print("access_flag_call: public(visible) 后函数调用失败")
		return None
	}
	if (CONST == 3) {
	} else {
		io.print("access_flag_call: readonly(CONST) 后常量读取失败")
		return None
	}
	// insp 应只含公开符号（人工观察：不含 secret / hidden）。
	io.print(pycp.insp(mod_flag))
	io.print("IMPORT TEST PASS: access_flag_call")
}
main()
