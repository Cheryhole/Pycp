import io
import pycp

class Box {
	v = 1
}

func main() {

	io.print(pycp.typeof(42))
	io.print((42).__class__)
	io.print(pycp.typeof("abc"))
	io.print(pycp.typeof(None))
	io.print(pycp.typeof(True))
	io.print(pycp.typeof([1, 2]))
	io.print(pycp.typeof({1: 2}))

	io.print(pycp.typeof(io.stdout))

	b = Box()
	io.print(pycp.typeof(b))
	io.print(b.__class__)

	io.print(pycp.typeof(Box))
	io.print(pycp.typeof(pycp.Integer))
	io.print(pycp.typeof(pycp.Object))

	io.print(pycp.typeof(io))

	io.print(pycp.insp("abc"))
	m = "abc".__map__()
	io.print("IMPORT TEST PASS: typeof_class")
}
main()
