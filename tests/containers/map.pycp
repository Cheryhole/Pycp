import io
import pycp

m = pycp.Map()
io.print(m)
io.print(m.length())
io.print(pycp.Boolean(m))

m["a"] = 1
m["b"] = 2
m[42] = "answer"
io.print(m)
io.print(m.length())
io.print(pycp.Boolean(m))

io.print(m["a"])
io.print(m["b"])
io.print(m[42])

m["a"] = 100
io.print(m["a"])
io.print(m.length())

delete m["b"]
io.print(m.length())
io.print(m)

i = 42
io.print(i.__hash__())
io.print(pycp.insp(i))
s = "abc"
io.print(s.__hash__())
io.print(pycp.insp(s))

io.print(m.length())
io.print(m.__inspect__())
io.print(pycp.insp(pycp.Map))

sm = "abc"
io.print(sm.__map__())

io.print(m.__map__())
io.print(m.__map__().__inspect__())

io.print(pycp.Boolean(""))
io.print(pycp.Boolean("x"))
io.print(pycp.Boolean(0))
io.print(pycp.Boolean(3))
io.print(pycp.Boolean(pycp.Map()))
io.print(pycp.Boolean(m))

class Point {
	x = 0
	y = 0
	func __str__(self) {
		return pycp.String(self.x) + "," + pycp.String(self.y)
	}
}
p = Point()
view = p.__map__()
io.print(view)
view["x"] = 10
io.print(p.x)
io.print(p.__map__())
view["z"] = 99
io.print(p.z)
io.print(p.__map__())

delete view["z"]
io.print(p.__map__())

delete p.x
io.print(p.__map__())

pt_view = p.__map__()
io.print(pt_view.__inspect__())
io.print(pt_view["__str__"] != None)

class Box {
	v = 5
}
b = Box()
b.dyn = "hello"
delete b.dyn
io.print(b.__map__())
delete b.v
io.print(b.__map__())

lst = [10, 20, 30]
delete lst[1]
io.print(lst)

class Resource {
	func __delete__(self) {
		io.print("resource cleaned up")
	}
}
r = Resource()
delete r

ml = {1: "one", 2: "two"}
io.print(ml.length())
io.print(ml[1])
io.print(ml[2])

n = {1: {2: 3}}
io.print(n[1][2])
io.print(n[1].length())

e = {}
io.print(e.length())
io.print(pycp.Boolean(e))

s = {"a": 10, "b": 20}
io.print(s["a"] + s["b"])

ml2 = {
	1: "one",
	2: "two",
}
io.print(ml2.length())
io.print(ml2[2])

lst2 = [
	1,
	2,
	3,
]
io.print(lst2.length())
io.print(lst2[0] + lst2[2])

mixed = {
	"nums": [
		1,
		2,
	],
	"flag": True,
}
io.print(mixed["nums"].length())
io.print(mixed["nums"][1])
io.print(pycp.Boolean(mixed["flag"]))

func pass_through(m) {
	return m
}
ret = pass_through({1: 2})
io.print(ret[1])

maplist = [{1: 2}, {3: 4}]
io.print(maplist.length())
io.print(maplist[0][1])
io.print(maplist[1][3])

ret2 = pass_through({
	5: 6,
})
io.print(ret2[5])

if True {
	inner = [
		7,
		8,
	]
	io.print(inner.length())
}

io.print("after block")

sum = (
	1 +
	2
)
io.print(sum)

deep = {
	"outer": {
		"inner": [
			1,
			2,
			3,
		],
	},
}
io.print(deep["outer"]["inner"].length())
io.print(deep["outer"]["inner"][2])

func first_key(m) {
	return m[1]
}
io.print(first_key({1: "a"}))

km = {"x": 1, "y": 2}
io.print(km.keys().length())
io.print(pycp.Boolean(km.keys().length() == km.length()))

cp = pycp.Map(km)
io.print(cp.length())
io.print(cp["x"])
cp["z"] = 3
io.print(cp.length())
io.print(km.length())

pm = pycp.Map([["a", 1], ["b", 2]])
io.print(pm.length())
io.print(pm["a"] + pm["b"])

class Bag {
	v = 7
}
bg = Bag()
snap = pycp.Map(bg.__map__())
io.print(snap["v"])
snap["v"] = 100
io.print(bg.v)

class Store {
	data = None
	func __initialize__(self) {
		self.data = pycp.Map()
		self.data["k1"] = 10
		self.data["k2"] = 20
	}
	func keys(self) {
		return self.data.keys()
	}
	func __get_item__(self, key) {
		return self.data[key]
	}
}
st = Store()
sm = pycp.Map(st)
io.print(sm.length())
io.print(sm["k1"])
io.print(sm["k2"])

io.print(pycp.insp(pycp.Map))
io.print(km.__inspect__())

io.print("done")
