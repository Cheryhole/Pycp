import io

t = 0

repeat if t < 5{
	io.print("Hello World 1")
	t = t + 1
}

io.print("")

repeat 10 as i{
	io.print("Hellos")
	io.print(i)
}

/*
repeat {
	io.print("Hellos")
}
*/

func return2(){
	return 2
}

repeat from 10 to 1 by -return2() as i{
	io.print(i)
}

for i in [1, 2, 3]{
	io.print(i)
}
