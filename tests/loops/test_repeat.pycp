import io
import pycp

func println(x) {
	io.stdout.write(pycp.String(x))
	io.stdout.write("\n")
}

func test_infinite() {
	i = 0
	repeat if True {
		i = i + 1
		if i >= 3 { break }
	}
	println(i)
}

func test_while() {
	i = 0
	repeat if i < 3 {
		println(i)
		i = i + 1
	}

}

func test_count() {
	n = 0
	repeat 10 {
		n = n + 1
	}
	println(n)
}

func test_count_as() {
	s = 0
	repeat 10 as i {
		s = s + i
	}
	println(s)
}

func test_range_up() {
	s = 0
	repeat from 1 to 10 as i {
		s = s + i
	}
	println(s)
}

func test_range_down() {
	s = 0
	repeat from 10 to 1 as i {
		s = s + i
	}
	println(s)
}

func test_range_by() {
	s = 0
	repeat from 1 to 10 by 2 as i {
		s = s + i
	}
	println(s)
}

func test_nested_break() {
	count = 0
	repeat 3 as i {
		repeat 10 as j {
			if j >= 2 { break }
			count = count + 1
		}
	}
	println(count)
}

test_infinite()
test_while()
test_count()
test_count_as()
test_range_up()
test_range_down()
test_range_by()
test_nested_break()
