// =============================================================
// repeat 循环 + break 综合测试
// =============================================================

import io
import pycp

func println(x) {
	io.stdout.write(pycp.String(x))
	io.stdout.write("\n")
}

// 1) 无限循环 + break 防死循环
func test_infinite() {
	i = 0
	repeat if True {
		i = i + 1
		if i >= 3 { break }
	}
	println(i)   // 3
}

// 2) repeat if cond {}  —— while 语义
func test_while() {
	i = 0
	repeat if i < 3 {
		println(i)
		i = i + 1
	}
	// 输出 0 1 2
}

// 3) repeat 10 {}（无 as）
func test_count() {
	n = 0
	repeat 10 {
		n = n + 1
	}
	println(n)   // 10
}

// 4) repeat 10 as i {}（0-based）
func test_count_as() {
	s = 0
	repeat 10 as i {
		s = s + i
	}
	println(s)   // 0+1+...+9 = 45
}

// 5) repeat from 1 to 10 as i（含端点，步长 +1）
func test_range_up() {
	s = 0
	repeat from 1 to 10 as i {
		s = s + i
	}
	println(s)   // 1+...+10 = 55
}

// 6) repeat from 10 to 1（默认步长 -1，自动反向）
func test_range_down() {
	s = 0
	repeat from 10 to 1 as i {
		s = s + i
	}
	println(s)   // 10+...+1 = 55
}

// 7) repeat from 1 to 10 by 2 as i（步长 +2）
func test_range_by() {
	s = 0
	repeat from 1 to 10 by 2 as i {
		s = s + i
	}
	println(s)   // 1+3+5+7+9 = 25
}

// 8) 嵌套循环 break 仅退出一层
func test_nested_break() {
	count = 0
	repeat 3 as i {
		repeat 10 as j {
			if j >= 2 { break }   // 内层只执行 j=0,1
			count = count + 1
		}
	}
	println(count)   // 每层 2 次 × 3 = 6
}

// 9) 循环外 break 编译期报错（此测试单独编译验证，不运行）
// break

test_infinite()
test_while()
test_count()
test_count_as()
test_range_up()
test_range_down()
test_range_by()
test_nested_break()
