// project.pycp —— AOT 项目脚手架与 CMake 生成（对应前端的 PycpCMakeGenerator）。
//
// 输入 spec（由 manifest 组装）：
//   sdk                : sdk.locate() 的结果（root/include_dir/lib_dir/...）
//   runtime_link       : "shared" | "static"
//   name               : 主程序名（入口模块名）
//   source_pycp        : 入口源路径（仅注释）
//   pycp_version       : 版本串（仅注释）
//   modules            : List[Map{ name, kind(static|shared), source_file, deps, reason }]
//   entry_deps         : List[模块名]（入口的直接依赖）
//   aux_sources        : List[文件名]（空）
//   builtin_static_lib_paths : List[绝对库路径]（空）
//   builtin_static     : List[模块名]（空）
//   builtin_shared     : List[模块名]（空）
// 输出：CMakeLists.txt 的完整文本内容。

from pycp import List, Map
import filesystem
from util import S, sanitize_module_name, map_has, str_less

func cmake_escape(s) {
	out = ""
	for ch in s {
		if (ch == "\\") {
			out = out + "\\\\"
		} elif (ch == "\"") {
			out = out + "\\\""
		} else {
			out = out + ch
		}
	}
	return out
}

func cmake_path(s) {
	out = ""
	for ch in s {
		if (ch == "\\") {
			out = out + "/"
		} elif (ch == "\"") {
			out = out + "\\\""
		} else {
			out = out + ch
		}
	}
	return out
}

func module_target(name) {
	return "pycp_mod_" + sanitize_module_name(name)
}

// 某链接目标（入口或模块）的「静态依赖闭包」：需要链入该目标的静态模块名集合。
func static_closure(start, modules, deps) {
	kinds = Map()
	for mt in modules {
		kinds[mt["name"]] = mt["kind"]
	}
	out = List()
	visited = Map()
	stack = List()
	d = deps[start]
	if (d != None) {
		for x in d {
			stack.append(x)
		}
	}
	sp = 0
	// 每个节点在被首次访问时才会把依赖压栈一次，故压栈总数 <= N*(N+1)，
	// 用该上界驱动 repeat，并在 sp 越界时 break（pycp 无 while/continue）。
	guard = (modules.length() + 1) * (modules.length() + 1) + 8
	repeat guard as _gi {
		if (sp >= stack.length()) {
			break
		}
		n = stack[sp]
		sp = sp + 1
		if (map_has(visited, n) == False) {
			visited[n] = True
			kk = kinds[n]
			if (kk != None) {
				if (kk == "static") {
					out.append(n)
					dd = deps[n]
					if (dd != None) {
						for x in dd {
							stack.append(x)
						}
					}
				}
			}
		}
	}
	return out
}

func emit_cmake(spec) {
	sdk = spec["sdk"]
	rt_shared = (spec["runtime_link"] == "shared")
	exe = spec["name"]
	modules = spec["modules"]
	entry_deps = spec["entry_deps"]
	aux = spec["aux_sources"]
	bsl = spec["builtin_static_lib_paths"]

	mod_static = List()
	mod_shared = List()
	for mt in modules {
		if (mt["kind"] == "shared") {
			mod_shared.append(mt)
		} else {
			mod_static.append(mt)
		}
	}

	deps = Map()
	for mt in modules {
		deps[mt["name"]] = mt["deps"]
	}
	deps[exe] = entry_deps

	closure = Map()
	closure[exe] = static_closure(exe, modules, deps)
	for mt in modules {
		closure[mt["name"]] = static_closure(mt["name"], modules, deps)
	}

	txt = ""

	// ---- 文件头 ----
	txt = txt + "# Generated by Pycp AOT (emit-cpp) v" + cmake_escape(spec["pycp_version"]) + "\n"
	txt = txt + "# Source entry : " + cmake_escape(spec["source_pycp"]) + "\n"
	if (rt_shared) {
		txt = txt + "# Runtime link : shared (libPycpRuntime)\n"
	} else {
		txt = txt + "# Runtime link : static (libPycpRuntime.a)\n"
	}
	txt = txt + "# Module kinds : " + S(mod_static.length()) + " static, " + S(mod_shared.length()) + " shared (one CMake target each)\n"
	for mt in modules {
		if (mt["kind"] == "shared") {
			kk = "shared"
		} else {
			kk = "static"
		}
		reason = mt["reason"]
		if (reason == None) {
			reason = "<default>"
		}
		txt = txt + "#   " + kk + "  " + mt["name"] + "  (" + reason + ")\n"
	}
	txt = txt + "# Builtin ext   : " + S(spec["builtin_static"].length()) + " static (linked in), " + S(spec["builtin_shared"].length()) + " shared (loaded from stdlib/)\n"
	txt = txt + "# Do not edit by hand; re-run: pycp --emit-cpp <entry>.pycp\n\n"

	txt = txt + "cmake_minimum_required(VERSION 3.15)\n"
	txt = txt + "project(" + exe + " LANGUAGES CXX)\n\n"

	txt = txt + "# Pycp 运行时 SDK 根目录（生成时写入的绝对路径；换机器用 -DPYCP_DIST=<path> 覆盖）\n"
	txt = txt + "set(PYCP_DIST \"" + cmake_path(sdk["root"]) + "\" CACHE PATH \"Pycp runtime SDK root\")\n\n"

	txt = txt + "set(CMAKE_CXX_STANDARD 17)\n"
	txt = txt + "set(CMAKE_CXX_STANDARD_REQUIRED ON)\n"
	txt = txt + "set(CMAKE_CXX_EXTENSIONS OFF)\n"
	txt = txt + "if(NOT CMAKE_BUILD_TYPE)\n"
	txt = txt + "    set(CMAKE_BUILD_TYPE Release)\n"
	txt = txt + "endif()\n\n"

	txt = txt + "# SDK 缺失时给出可操作的错误，而非晦涩的 \"cannot find -lPycpRuntime\"\n"
	txt = txt + "if(NOT EXISTS \"${PYCP_DIST}/include/abi/PycpABI.hpp\")\n"
	txt = txt + "    message(FATAL_ERROR\n"
	txt = txt + "        \"Pycp SDK not found at: ${PYCP_DIST}\\n\"\n"
	txt = txt + "        \"请指定正确的 SDK 路径：cmake -S . -B build -DPYCP_DIST=<pycp 的 build/dist>\")\n"
	txt = txt + "endif()\n\n"

	// ---- 入口源与辅助源 ----
	txt = txt + "# 入口模块与辅助源（注册/拉入桩）编进主程序可执行文件\n"
	txt = txt + "set(PYCP_ENTRY_SRC \"__pycp_main.gen.cpp\")\n"
	if (aux.length() == 0) {
		txt = txt + "set(PYCP_AUX_SRCS)\n"
	} else {
		txt = txt + "set(PYCP_AUX_SRCS\n"
		for a in aux {
			txt = txt + "    " + a + "\n"
		}
		txt = txt + ")\n"
	}
	txt = txt + "\n"

	// ---- 主程序 ----
	txt = txt + "# ---- 主程序（入口模块 + 辅助源）----\n"
	txt = txt + "add_executable(" + exe + " ${PYCP_ENTRY_SRC} ${PYCP_AUX_SRCS})\n\n"

	// ---- 依赖模块 ----
	if (modules.length() > 0) {
		txt = txt + "# ---- 依赖模块：逐模块一个 target（static -> 归档，shared -> DLL）----\n"
		for mt in modules {
			t = module_target(mt["name"])
			is_shared = (mt["kind"] == "shared")
			if (is_shared) {
				kt = "shared"
			} else {
				kt = "static"
			}
			reason = mt["reason"]
			if (reason == None) {
				rtxt = ""
			} else {
				rtxt = ", " + reason
			}
			txt = txt + "# " + mt["name"] + " (" + kt + rtxt + ")\n"
			if (is_shared) {
				txt = txt + "add_library(" + t + " SHARED " + mt["source_file"] + ")\n"
			} else {
				txt = txt + "add_library(" + t + " STATIC " + mt["source_file"] + ")\n"
			}
			txt = txt + "set_target_properties(" + t + " PROPERTIES\n"
			txt = txt + "    OUTPUT_NAME \"" + mt["name"] + "\"\n"
			if (is_shared) {
				txt = txt + "    PREFIX \"\"\n"
			} else {
				txt = txt + "    POSITION_INDEPENDENT_CODE ON\n"
			}
			txt = txt + ")\n"
		}
		txt = txt + "\n"
	}

	// ---- 各 target 的 include/link 目录 ----
	txt = txt + "target_include_directories(" + exe + " PRIVATE \"${PYCP_DIST}/include\")\n"
	txt = txt + "target_link_directories(" + exe + " PRIVATE \"${PYCP_DIST}/lib\")\n"
	for mt in modules {
		t = module_target(mt["name"])
		txt = txt + "target_include_directories(" + t + " PRIVATE \"${PYCP_DIST}/include\")\n"
		txt = txt + "target_link_directories(" + t + " PRIVATE \"${PYCP_DIST}/lib\")\n"
	}
	txt = txt + "\n"

	// ---- 编译定义 ----
	if (rt_shared == False) {
		txt = txt + "target_compile_definitions(" + exe + " PRIVATE PYCP_STATIC)\n"
		for mt in mod_static {
			txt = txt + "target_compile_definitions(" + module_target(mt["name"]) + " PRIVATE PYCP_STATIC)\n"
		}
		txt = txt + "\n"
	}
	for mt in mod_shared {
		txt = txt + "target_compile_definitions(" + module_target(mt["name"]) + " PRIVATE PYCP_BUILDING_MODULE)\n"
	}
	if (mod_shared.length() > 0) {
		txt = txt + "\n"
	}

	// ---- 链接 ----
	txt = txt + "# ---- 链接 ----\n"
	if (closure[exe].length() > 0) {
		txt = txt + "# 主程序链接其静态依赖闭包（链接器按符号拉取所需成员）。\n"
	}
	txt = txt + "target_link_libraries(" + exe + " PRIVATE\n"
	for n in closure[exe] {
		txt = txt + "    " + module_target(n) + "\n"
	}
	if (bsl.length() > 0) {
		txt = txt + "    # 静态链入的内置扩展（绝对路径，避免 MinGW 选中同目录的\n"
		txt = txt + "    # DLL 导入库）；须排在运行时之前，GNU ld 按左到右解析。\n"
		for lib in bsl {
			txt = txt + "    \"" + cmake_path(lib) + "\"\n"
		}
	}
	if (rt_shared) {
		txt = txt + "    PycpRuntime\n"
	} else {
		txt = txt + "    # 静态运行时（绝对路径，避免 MinGW 选中同目录的 DLL 导入库\n"
		txt = txt + "    # libPycpRuntime.dll.a）\n"
		txt = txt + "    \"" + cmake_path(sdk["static_runtime"]) + "\"\n"
		if (sdk["static_mpdec"] == "") {
			// 无 mpdecimal 静态库
		} else {
			txt = txt + "    \"" + cmake_path(sdk["static_mpdec"]) + "\"\n"
		}
	}
	txt = txt + ")\n\n"

	for mt in mod_static {
		cl = closure[mt["name"]]
		if (cl.length() > 0) {
			t = module_target(mt["name"])
			txt = txt + "target_link_libraries(" + t + " PUBLIC\n"
			for n in cl {
				txt = txt + "    " + module_target(n) + "\n"
			}
			txt = txt + ")\n"
		}
	}
	if (mod_static.length() > 0) {
		txt = txt + "\n"
	}

	for mt in mod_shared {
		t = module_target(mt["name"])
		txt = txt + "target_link_libraries(" + t + " PRIVATE\n"
		for n in closure[mt["name"]] {
			txt = txt + "    " + module_target(n) + "\n"
		}
		txt = txt + "    PycpRuntime\n"
		txt = txt + ")\n"
		txt = txt + "set_target_properties(" + t + " PROPERTIES\n"
		txt = txt + "    BUILD_RPATH   \"${PYCP_DIST}/lib;$ORIGIN;$ORIGIN/lib\"\n"
		txt = txt + "    INSTALL_RPATH \"$ORIGIN;$ORIGIN/lib\"\n"
		txt = txt + ")\n"
	}
	if (mod_shared.length() > 0) {
		txt = txt + "\n"
	}

	// ---- rpath / 部署：仅存在动态形态时需要 ----
	if (rt_shared == False) {
		if (mod_shared.length() == 0) {
			if (spec["builtin_shared"].length() == 0) {
				txt = txt + "# 全静态自包含产物：无 DLL、无 rpath、无需运行期部署。\n"
				return txt
			}
		}
	}

	txt = txt + "# rpath：让 exe 在任何目录都能找到同级 lib/ 下的运行时库\n"
	txt = txt + "set_target_properties(" + exe + " PROPERTIES\n"
	txt = txt + "    BUILD_RPATH   \"${PYCP_DIST}/lib;$ORIGIN/lib;$ORIGIN\"\n"
	txt = txt + "    INSTALL_RPATH \"$ORIGIN/lib;$ORIGIN\"\n"
	txt = txt + ")\n\n"

	txt = txt + "# Linux/macOS：导出主程序符号，使 import 的「进程内符号」查找\n"
	txt = txt + "# （dlsym(RTLD_DEFAULT, \"PycpModule_xxx\")）能命中链接进本程序的模块。\n"
	txt = txt + "if(UNIX AND NOT APPLE)\n"
	txt = txt + "    target_link_options(" + exe + " PRIVATE -rdynamic)\n"
	txt = txt + "endif()\n\n"

	txt = txt + "# 运行期部署：import io 等按「exe 同级 stdlib/」查找原生扩展，\n"
	txt = txt + "# 且 io.so 自身 rpath 指向 $ORIGIN/../lib，故 lib/ 必须一并复制。\n"
	txt = txt + "add_custom_command(TARGET " + exe + " POST_BUILD\n"
	txt = txt + "    COMMAND ${CMAKE_COMMAND} -E copy_directory\n"
	txt = txt + "            \"${PYCP_DIST}/stdlib\" $<TARGET_FILE_DIR:" + exe + ">/stdlib\n"
	txt = txt + "    COMMAND ${CMAKE_COMMAND} -E copy_directory\n"
	txt = txt + "            \"${PYCP_DIST}/lib\" $<TARGET_FILE_DIR:" + exe + ">/lib\n"
	txt = txt + ")\n\n"

	txt = txt + "# Windows：加载 DLL 只搜 exe 同级目录、不搜 lib/，故运行时 DLL 额外放一份。\n"
	txt = txt + "# DLL 名随构建 SDK 的编译器而异：MinGW -> libPycpRuntime.dll，MSVC -> PycpRuntime.dll。\n"
	txt = txt + "if(WIN32)\n"
	txt = txt + "    set(_pycp_runtime_dll \"\")\n"
	txt = txt + "    foreach(_pycp_dll_cand"
	for cand in dll_candidates(sdk) {
		txt = txt + " \"" + cmake_escape(cand) + "\""
	}
	txt = txt + ")\n"
	txt = txt + "        if(EXISTS \"${PYCP_DIST}/${_pycp_dll_cand}\")\n"
	txt = txt + "            set(_pycp_runtime_dll \"${PYCP_DIST}/${_pycp_dll_cand}\")\n"
	txt = txt + "            break()\n"
	txt = txt + "        endif()\n"
	txt = txt + "    endforeach()\n"
	txt = txt + "    if(NOT _pycp_runtime_dll)\n"
	txt = txt + "        foreach(_pycp_dll_cand \"libPycpRuntime.dll\" \"PycpRuntime.dll\")\n"
	txt = txt + "            if(EXISTS \"${PYCP_DIST}/lib/${_pycp_dll_cand}\")\n"
	txt = txt + "                set(_pycp_runtime_dll \"${PYCP_DIST}/lib/${_pycp_dll_cand}\")\n"
	txt = txt + "                break()\n"
	txt = txt + "            endif()\n"
	txt = txt + "        endforeach()\n"
	txt = txt + "    endif()\n"
	txt = txt + "    if(_pycp_runtime_dll)\n"
	txt = txt + "        add_custom_command(TARGET " + exe + " POST_BUILD\n"
	txt = txt + "            COMMAND ${CMAKE_COMMAND} -E copy_if_different\n"
	txt = txt + "                    \"${_pycp_runtime_dll}\" $<TARGET_FILE_DIR:" + exe + ">/\n"
	txt = txt + "        )\n"
	txt = txt + "    else()\n"
	txt = txt + "        message(STATUS \"Pycp: ${PYCP_DIST} 下未找到运行时 DLL（纯静态 SDK？），跳过复制到 exe 同级目录。\")\n"
	txt = txt + "    endif()\n"
	txt = txt + "endif()\n\n"

	if (mod_shared.length() > 0) {
		txt = txt + "# 动态模块 DLL 复制到 exe 同级 stdlib/（运行期按名 dlopen）\n"
		for mt in mod_shared {
			t = module_target(mt["name"])
			txt = txt + "add_dependencies(" + exe + " " + t + ")\n"
			txt = txt + "add_custom_command(TARGET " + exe + " POST_BUILD\n"
			txt = txt + "    COMMAND ${CMAKE_COMMAND} -E copy_if_different\n"
			txt = txt + "            $<TARGET_FILE:" + t + "> $<TARGET_FILE_DIR:" + exe + ">/stdlib/\n"
			txt = txt + ")\n"
		}
	}

	return txt
}

// 运行时 DLL 候选名（去重）：SDK 实际产出名优先，其后补两种编译器约定名。
func dll_candidates(sdk) {
	out = List()
	root_dll = sdk["root_dll"]
	if (root_dll == "") {
		// 无运行时 DLL（纯静态 SDK）
	} else {
		out.append(filesystem.basename(root_dll))
	}
	c0 = "libPycpRuntime.dll"
	c1 = "PycpRuntime.dll"
	has_c0 = False
	has_c1 = False
	for c in out {
		if (c == c0) {
			has_c0 = True
		}
		if (c == c1) {
			has_c1 = True
		}
	}
	if (has_c0 == False) {
		out.append(c0)
	}
	if (has_c1 == False) {
		out.append(c1)
	}
	return out
}
