// aot/package.mpycp —— AOT 编译器的 pycp 实现（当前无 C++ AOT，纯 pycp 自举）。
//
// 用法：pycp -m aot <入口 .pycp | 模块文件夹> <输出目录> [形态选项]
//   形态选项（由 aot 模块直接解析，与 pycp -m aot 的调用参数同名）：
//     --compile-runtime=shared|static   运行时库链接方式（默认 shared）
//     --compile-modules=shared|static   依赖模块默认形态（默认 shared）
//     --compile-module:<name>=shared|static   按模块覆盖形态
//     --show-imports                    额外打印逐模块形态决策表
//   - 经 bytecode.load_set 递归加载「入口 + 全部 import 依赖」的字节码；
//   - 经 bytecode.eval_manifest 在受控 VM 中执行包清单顶层，读回形态决策；
//   - plan.build_plan 决定每个模块的静态/动态形态；
//   - emit.emit_all 逐模块翻译字节码为 C++ 源码（与 C++ AOT 逐字节一致）；
//   - project.emit_cmake 生成 CMakeLists.txt；
//   - 最终用 filesystem 把 .gen.cpp 与 CMakeLists.txt 落盘。
//
// 用 moduletools 声明本清单为程序入口（pycp -m aot 调用 main(argv)）。

import io
from pycp import List, Map
import bytecode
import filesystem
import moduletools
from util import S, sorted_map_keys, map_has, list_has, starts_with, str_len, substr, find
from util import sanitize_identifier, cpp_string_literal
from sdk import locate
from plan import build_plan
from emit import emit_all, resolve_deps
from project import emit_cmake

moduletools.as_program()

// AOT 配置键（来自 bytecode.aot_config，与 C++ 的 AOT_* 约定同源）。
func cfg(key) {
	c = bytecode.aot_config()
	return S(c[key])
}

// 模块名 -> 生成的 C++ 文件相对路径。
//   入口模块     固定为 __pycp_main.gen.cpp（含 main 函数）；
//   包清单模块（包根，如 lib_pkg）落在包目录内 <pkg>/pycp.gen.cpp，与子模块同处
//                 一个目录（旧 C++ AOT 的布局约定，测试据此校验）；
//   其余依赖模块 把模块名的 '.' 映射为路径分隔符（lib_pkg.util -> lib_pkg/util.gen.cpp）。
func module_cpp_filename(entry_name, name, pkgs) {
	if (name == entry_name) {
		return cfg("aot_entry_cpp_filename")
	}
	if (list_has(pkgs, name)) {
		return name + "/pycp.gen.cpp"
	}
	rel = ""
	for ch in name {
		if (ch == ".") {
			rel = rel + "/"
		} else {
			rel = rel + ch
		}
	}
	return rel + cfg("aot_cpp_suffix")
}

// 逐级创建 relpath 中的父目录（"a/b/c.gen.cpp" -> out_dir/a、out_dir/a/b）。
func ensure_parent_dirs(out_dir, relpath) {
	cur = out_dir
	seg = ""
	for ch in relpath {
		if (ch == "/") {
			cur = filesystem.join(cur, seg)
			filesystem.mkdir(cur)
			seg = ""
		} else {
			seg = seg + ch
		}
	}
}

// 静态链入的内置扩展的「链接拉入 / 注册」桩源码。
// 引用 PycpModule_<name> 使链接器从 libPycpExt_<name>.a 拉取该成员（否则
// 其静态初始化器会被整体丢弃），并在静态初始化阶段登记到 AOT 注册表，
// 供 ImportModule 在 dlsym 未命中时直接调用（Windows 下 exe 不导出符号）。
func emit_builtin_reg(mods) {
	out = "// =====================================================\n"
	out = out + "// Auto-generated by Pycp AOT compiler.\n"
	out = out + "// Builtin static extensions registration (link pull-in + registry).\n"
	out = out + "// Do not edit manually.\n"
	out = out + "// =====================================================\n\n"
	out = out + "#include \"abi/PycpABI.hpp\"\n\n"
	for m in mods {
		sym = "PycpModule_" + sanitize_identifier(m)
		out = out + "extern \"C\" Pycp::Module* " + sym + "();\n"
	}
	out = out + "\nnamespace {\n"
	out = out + "struct PycpBuiltinReg {\n"
	out = out + "  PycpBuiltinReg() {\n"
	for m in mods {
		sym = "PycpModule_" + sanitize_identifier(m)
		out = out + "    Pycp::RegisterAotModule(" + cpp_string_literal(m) + ", &" + sym + ");\n"
	}
	out = out + "  }\n"
	out = out + "};\n"
	out = out + "PycpBuiltinReg _pycp_builtin_reg;\n"
	out = out + "}  // namespace\n"
	return out
}

// 落盘：把 sources（Map[模块名 -> 源码]）与 CMakeLists.txt 写入 out_dir。
// 用二进制写（"wb"）：不随平台做换行改写，保证与旧 C++ AOT（二进制 ofstream）
// 逐字节一致——Windows 下若用文本模式会把 \n 写成 \r\n。
func write_all(out_dir, entry_name, sources, cmake_txt, pkgs) {
	filesystem.mkdir(out_dir)
	for mk in sources.keys() {
		nm = S(mk)
		fname = module_cpp_filename(entry_name, nm, pkgs)
		ensure_parent_dirs(out_dir, fname)
		fpath = filesystem.join(out_dir, fname)
		f = filesystem.File(fpath, "wb")
		f.write(sources[mk])
		f.close()
	}
	cf = filesystem.File(filesystem.join(out_dir, "CMakeLists.txt"), "wb")
	cf.write(cmake_txt)
	cf.close()
}

// 入口 basename：去掉目录前缀与扩展名，用作缺省输出目录（./<入口名>/）。
func entry_basename(p) {
	last_slash = -1
	idx = 0
	for ch in p {
		if (ch == "/") {
			last_slash = idx
		} elif (ch == "\\") {
			last_slash = idx
		}
		idx = idx + 1
	}
	if (last_slash < 0) {
		name = p
	} else {
		name = substr(p, last_slash + 1, str_len(p))
	}
	last_dot = -1
	idx = 0
	for ch in name {
		if (ch == ".") {
			last_dot = idx
		}
		idx = idx + 1
	}
	if (last_dot <= 0) {
		return name
	}
	return substr(name, 0, last_dot)
}

func print_help() {
	io.print("usage: pycp -m aot <entry.pycp | module folder> [out_dir] [options]")
	io.print("")
	io.print("Translate a .pycp source (or a module folder / package) into a")
	io.print("standalone, compilable C++ project (CMake). The generated <out_dir>/")
	io.print("contains __pycp_main.gen.cpp (with main()), one <name>.gen.cpp per")
	io.print("imported module, and a CMakeLists.txt.")
	io.print("")
	io.print("positional arguments:")
	io.print("  entry      path to a .pycp file, or a module folder (directory")
	io.print("             containing package.mpycp), or a package name resolved")
	io.print("             from the import path.")
	io.print("  out_dir    output directory (default: ./<entry basename>/).")
	io.print("")
	io.print("options:")
	io.print("  --compile-runtime=shared|static       link mode of libPycpRuntime")
	io.print("                                        (default shared).")
	io.print("  --compile-modules=shared|static       global kind of translated modules")
	io.print("                                        (default shared).")
	io.print("  --compile-module:<name>=shared|static per-module override.")
	io.print("  --show-imports                        print the import resolution")
	io.print("                                        manifest and per-module link-kind table.")
	io.print("  -h, --help                            show this help and exit.")
	io.print("")
	io.print("examples:")
	io.print("  pycp -m aot hello.pycp")
	io.print("  pycp -m aot hello.pycp hello_build --compile-modules=static")
	io.print("  pycp -m aot my_pkg                   # module folder as a package")
}

func main(argv) {
	n = argv.length()
	// --help / -h：打印用法并退出 0（出现在任意位置）。
	help = False
	repeat n as hi {
		a = argv[hi]
		if (a == "--help") {
			help = True
		}
		if (a == "-h") {
			help = True
		}
	}
	if (help == True) {
		print_help()
		return 0
	}
	// 参数不足（缺入口或输出目录）-> 打印用法并退出 2。
	if (n < 3) {
		print_help()
		return 2
	}
	entry_path = argv[1]
	// 输出目录可选：缺省取入口 basename（对齐早期默认 ./<入口名>/）。
	out_dir = ""
	if (n >= 3) {
		if (starts_with(argv[2], "-") == False) {
			out_dir = argv[2]
		}
	}
	if (out_dir == "") {
		out_dir = entry_basename(entry_path)
	}

	// 0) 解析形态选项（由 `pycp -m aot` 之后的 argv 原样传入 main(argv)）。
	runtime_link = "shared"
	default_kind = "shared"
	overrides = Map()
	show_imports = False
	argc = argv.length()
	repeat argc as ai {
		if (ai >= 3) {
			a = argv[ai]
			if (starts_with(a, "--compile-runtime=")) {
				runtime_link = substr(a, 18, str_len(a))
			} elif (starts_with(a, "--compile-modules=")) {
				default_kind = substr(a, 18, str_len(a))
			} elif (starts_with(a, "--compile-module:")) {
				body = substr(a, 17, str_len(a))
				eq = find(body, "=")
				if (eq != None) {
					overrides[substr(body, 0, eq)] = substr(body, eq + 1, str_len(body))
				}
			} elif (a == "--show-imports") {
				show_imports = True
			}
		}
	}

	// 1) 递归加载入口及其 import 依赖的字节码。
	res = bytecode.load_set(entry_path)
	entry_name = res["entry_name"]
	modules_map = res["modules"]
	pkgs = res["package_names"]
	if (pkgs == None) {
		pkgs = List()
	}

	// 2) 形态决策所需的清单信息（受控 VM 执行顶层）。
	man = bytecode.eval_manifest(modules_map, entry_name, pkgs)
	has_codegen = man["has_codegen"]
	role = man["role"]
	role_declared = man["role_declared"]
	executable_name = man["executable_name"]
	module_kinds = man["module_kinds"]

	// 2a) 角色诊断与用途校验（见 README「AOT 形态与链接」）：
	//   - 未声明角色：AOT 默认按【库】转译，打印提示；
	//   - 库角色不得写 set_executable_name()（可执行名由入口项目决定）→ 中止。
	is_package = list_has(pkgs, entry_name)
	if (is_package == True) {
		if (role_declared == True) {
			// 清单已声明角色（moduletools.as_program() / as_library()）
		} else {
			io.print("note: no role declared; generating as a library (the AOT default).")
		}
		if (role == "library") {
			io.print("note: translating as a library package (no program entry).")
		}
	}
	if (role == "library") {
		if (executable_name == None) {
			// 未指定可执行名
		} elif (executable_name == "") {
			// 未指定可执行名
		} else {
			io.print("AOT error: set_executable_name() is not allowed for a library package '" + entry_name + "' (the executable name is decided by the entry project).")
			return 1
		}
	}

	// 形态标志必须是布尔 False（而非 None）：emit 侧用 `library_package_entry
	// == False` 判定是否给入口写 __main__；None 与布尔不可比较，会误判。
	program_entry = False
	library_package_entry = False
	if (role == "program") {
		program_entry = entry_name
	} elif (has_codegen == True) {
		if (role == "library") {
			library_package_entry = entry_name
		}
	}

	// 2b) 合并「清单 __codegen__ 声明的形态」与「命令行 --compile-module 覆盖」
	//     （后者优先），作为 build_plan 的显式形态表。
	plan_overrides = Map()
	if (module_kinds != None) {
		for mk in module_kinds.keys() {
			plan_overrides[S(mk)] = module_kinds[mk]
		}
	}
	for ok in overrides.keys() {
		plan_overrides[ok] = overrides[ok]
	}

	// 2c) 冲突裁决所需的「来源」标记：
	//   strict_names     —— 由 __codegen__ 声明为 static（冲突即报错中止）；
	//   cli_static_names —— 由 CLI --compile-module:<name>=static 声明（冲突附标记）。
	strict_names = List()
	if (module_kinds != None) {
		for sk in module_kinds.keys() {
			if (module_kinds[sk] == "static") {
				strict_names.append(S(sk))
			}
		}
	}
	cli_static_names = List()
	for ck in overrides.keys() {
		if (overrides[ck] == "static") {
			cli_static_names.append(S(ck))
		}
	}

	// 3) 定位运行时 SDK（提供 include/lib/stdlib 与运行时库）。
	sdk_info = locate()
	if (sdk_info["valid"] != True) {
		io.print("AOT error: Pycp runtime SDK not found (the directory next to the executable must contain include/, lib/ and stdlib/).")
		for td in sdk_info["tried"] {
			io.print("  - " + td)
		}
		return 2
	}

	// 4) 内置扩展形态分类：默认取 default_kind，--compile-module 覆盖优先。
	//    静态者需要其 .a 绝对路径参与链接（避免 MinGW 选中同目录 DLL 导入库）。
	builtin_mods = sdk_info["builtin_modules"]
	lib_map = sdk_info["builtin_lib_map"]
	builtin_static = List()
	builtin_shared = List()
	builtin_static_lib_paths = List()
	for bm in builtin_mods {
		bk = default_kind
		if (map_has(plan_overrides, bm)) {
			bk = plan_overrides[bm]
		}
		if (bk == "static") {
			builtin_static.append(bm)
			if (map_has(lib_map, bm)) {
				builtin_static_lib_paths.append(lib_map[bm])
			}
		} else {
			builtin_shared.append(bm)
		}
	}

	// 5) 模块直接依赖图（仅模块集内部依赖，用于形态决策与链接闭包）。
	names = sorted_map_keys(modules_map)
	deps_map = Map()
	for nm in names {
		deps_map[nm] = resolve_deps(modules_map, modules_map[nm])
	}

	// 6) 形态决策：每个模块静态 / 动态。
	plan_res = build_plan(names, deps_map, entry_name, default_kind, plan_overrides, strict_names, cli_static_names)
	kinds = plan_res["kinds"]
	reasons = plan_res["reasons"]

	// 6b) __codegen__ 指定的 static 若必须改为 shared -> 报错中止（不静默改写
	//     脚本意图；附宿主演算明细）。
	conflicts = plan_res["conflicts"]
	if (conflicts.length() > 0) {
		io.print("AOT error: these modules are declared static by __codegen__ but are referenced by >=2 link targets, so they must be shared; refusing to silently rewrite the script's intent:")
		for cf in conflicts {
			io.print("  - " + cf)
		}
		return 1
	}

	// 7) 两份运行时防护：runtime=static 时不允许任何动态形态（静态运行时的
	//    符号与动态模块各自链接的运行时互不共享，会产生两份运行时状态）。
	if (runtime_link == "static") {
		dyn_modules = List()
		for nm in names {
			if (kinds[nm] == "shared") {
				dyn_modules.append(nm)
			}
		}
		for bm in builtin_shared {
			dyn_modules.append(bm)
		}
		if (dyn_modules.length() > 0) {
			io.print("AOT error: --compile-runtime=static requires every module to be statically linked (two-runtime guard); dynamic modules were detected, use --compile-modules=static instead:")
			for dm in dyn_modules {
				io.print("  - " + dm)
			}
			return 2
		}
	}

	// 8) 逐模块翻译字节码 -> C++ 源码。
	sources = emit_all(modules_map, entry_name, kinds, default_kind, program_entry, library_package_entry, pkgs)

	// 8b) 静态内置扩展：追加链接拉入 / 注册桩源。
	aux_sources = List()
	if (builtin_static.length() > 0) {
		sources["__pycp_builtin_reg"] = emit_builtin_reg(builtin_static)
		aux_sources.append("__pycp_builtin_reg.gen.cpp")
	}

	// 9) 组装 CMake 模块列表（入口编进 exe，不在此列）。
	cmake_modules = List()
	for nm in names {
		if (nm == entry_name) {
			// 入口编进 exe，不在此列
		} else {
			mf = Map()
			mf["name"] = nm
			if (map_has(kinds, nm)) {
				mf["kind"] = kinds[nm]
			} else {
				mf["kind"] = default_kind
			}
			mf["source_file"] = module_cpp_filename(entry_name, nm, pkgs)
			if (map_has(deps_map, nm)) {
				mf["deps"] = deps_map[nm]
			} else {
				mf["deps"] = List()
			}
			if (map_has(reasons, nm)) {
				mf["reason"] = reasons[nm]
			} else {
				mf["reason"] = None
			}
			cmake_modules.append(mf)
		}
	}

	entry_deps = List()
	if (map_has(deps_map, entry_name)) {
		entry_deps = deps_map[entry_name]
	}

	// 10) 生成 CMakeLists.txt。
	// 可执行文件名：清单 as_program 可指定 executable_name（如 prog_app），
	// 否则取入口模块名。
	exe_name = entry_name
	if (executable_name == None) {
		// 未指定，用入口名
	} else {
		if (executable_name == "") {
			// 空串，用入口名
		} else {
			exe_name = executable_name
		}
	}
	spec = Map()
	spec["sdk"] = sdk_info
	spec["runtime_link"] = runtime_link
	spec["name"] = exe_name
	spec["source_pycp"] = entry_path
	spec["pycp_version"] = "1.0.0"
	spec["modules"] = cmake_modules
	spec["entry_deps"] = entry_deps
	spec["aux_sources"] = aux_sources
	spec["builtin_static_lib_paths"] = builtin_static_lib_paths
	spec["builtin_static"] = builtin_static
	spec["builtin_shared"] = builtin_shared
	cmake_txt = emit_cmake(spec)

	// 11) 落盘。
	write_all(out_dir, entry_name, sources, cmake_txt, pkgs)

	// 12) --show-imports：打印逐模块形态决策表（与旧 C++ AOT 同格式）。
	if (show_imports == True) {
		if (is_package == True) {
			decl = "default"
			if (role_declared == True) {
				decl = "declared"
			}
			io.print("Package: " + entry_name + "  role=" + role + "  <- " + decl)
		}
		// 编译期 import 解析清单：模块集内 -> translated（会生成 .gen.cpp）；
		// 集外 import（原生扩展等）-> unresolved（运行期按名解析）。
		for tn in names {
			io.print("translated  " + tn)
		}
		outside = List()
		for sn in names {
			for imp in modules_map[sn].imports {
				if (map_has(modules_map, imp)) {
					// 集内模块，已计入 translated
				} elif (list_has(outside, imp)) {
					// 已记录，去重
				} else {
					outside.append(imp)
				}
			}
		}
		for on in outside {
			io.print("unresolved  " + on)
		}
		io.print("Module kinds (" + S(cmake_modules.length()) + "):")
		for mt in cmake_modules {
			reason = mt["reason"]
			if (reason == None) {
				reason = "<default>"
			}
			io.print("  " + mt["kind"] + "  " + mt["name"] + "  (" + reason + ")")
		}
	}

	io.print("AOT: " + S(names.length()) + " module(s), entry = " + entry_name + ", runtime = " + runtime_link)
	return 0
}
